{
  "name": "smart-todo-frontend",
  "version": "0.0.0",
  "scripts": {
    "start": "serve dist/SmartTodoFrontend --single --listen tcp://0.0.0.0:${PORT:-8080}",
    "build": "ng build --configuration production",
    "ng": "ng",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@auth0/angular-jwt": "^5.2.0",
    "@stomp/rx-stomp": "^2.2.0",
    "@stripe/stripe-js": "^7.9.0",
    "@types/sockjs-client": "^1.5.4",
    "ngx-stripe": "^20.7.0",
    "rxjs": "~7.8.0",
    "serve": "^14.2.5",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.3",
    "@angular/cli": "^20.3.3",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "@types/sockjs": "^0.3.36",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
